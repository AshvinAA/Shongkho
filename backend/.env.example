# ============================================================
# Shongkho — backend environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database (required) ---
# TiDB / MySQL in production, SQLite for quick local dev:
# TIDB_DATABASE_URL=mysql+pymysql://user:pass@host:4000/db
# TIDB_DATABASE_URL=sqlite:///./Shongkho_dev.db
TIDB_DATABASE_URL=

# --- Session signing (required in prod) ---
SESSION_SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-STRING

# --- Analytics executor ---
# sync (default): pipeline runs inside the POST /analytics/run request.
#   No Redis or Celery needed.
# celery: production chord via Redis. Requires celery+redis packages AND
#   a running worker (see docs/ANALYTICS_SETUP.md).
ANALYTICS_EXECUTOR=sync

# --- Celery / Redis (only needed when ANALYTICS_EXECUTOR=celery) ---
# Broker + result backend for the analytics chord. Any Redis works;
# on Windows use Memurai or Redis in WSL (see docs/ANALYTICS_SETUP.md).
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- LLM (stage 2+ — leave empty for stage 1) ---
GEMINI_API_KEY=
